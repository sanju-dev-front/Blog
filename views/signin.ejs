<!DOCTYPE html>
<html lang="en">
<head>
   <%- include('./partials/head.ejs') %>
  <title>Sign in | Blogger</title>
</head>
<body>
    <%- include('./partials/nav.ejs') %>
<main class="page-shell form-layout auth-layout">
  <form class="form-card" action="/user/signin" method="POST">
   <div class="eyebrow">Welcome back</div>
   <h1>Sign in</h1>
   <p class="form-intro">Pick up where your reading left off.</p>
   <div class="mb-3">
    <label for="email" class="form-label">Email address</label>
    <input type="email" class="form-control" id="email" name="email" aria-describedby="emailHelp">
    <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
  </div>
  <div class="mb-3">
    <label for="password" class="form-label">Password</label>
    <input type="password" class="form-control" id="password" name="password">
  </div>
  <!-- <div class="mb-3 form-check">
    <input type="checkbox" class="form-check-input" id="exampleCheck1">
    <label class="form-check-label" for="exampleCheck1">Check me out</label>
  </div> -->
  <button type="submit" class="btn btn-accent">Sign in</button>
  <p class="auth-switch">New here? <a href="/user/signup">Create an account</a></p>
  </form>
</main>
    <%- include('./partials/scripts.ejs') %>
</body>
</html>