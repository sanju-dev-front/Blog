<!DOCTYPE html>
<html lang="en">
<head>
   <%- include('./partials/head.ejs') %>
  <title>Add Blog</title>
  <!-- <link rel="stylesheet" href="/styles.css"> -->
</head>
<body>
    <%- include('./partials/nav.ejs') %>
<div class="container mt-5">
    <form action="/blog" method="POST" enctype="multipart/form-data" >
         <div class="mb-3">
    <label for="coverImage" class="form-label">cover image</label>
    <input type="file" class="form-control" id="coverImage" name="coverImage" aria-describedby="coverImageHelp">
    <div id="coverImageHelp" class="form-text">Upload the cover image.</div>
  </div>
  <div class="mb-3">
    <label for="title" class="form-label">title</label>
    <input type="text" class="form-control" id="title" name="title" aria-describedby="title">
    <div id="titleHelp" class="form-text">Enter a title for your blog post.</div>
  </div>
  <div class="mb-3">
    <label for="body" class="form-label">Body</label>
    <textarea class="form-control" id="body" name="body" rows="5" aria-describedby="bodyHelp"></textarea>
    <div id="bodyHelp" class="form-text">Enter the content for your blog post.</div>
  </div>
  <div class="mb-3">
   <button type="submit" class="btn btn-primary">Submit</button>
  </div>
  </form>
    <%- include('./partials/scripts.ejs') %>
</body>
</html>