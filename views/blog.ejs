<!DOCTYPE html>
<html lang="en">
<head>
   <%- include('./partials/head.ejs') %>
    <title><%= blog.title %> | Blogger</title>
</head>
<body>
    <%- include('./partials/nav.ejs') %>
        <main class="page-shell">
            <article class="article">
                <header class="article-header">
                    <div class="eyebrow">From the community</div>
                    <h1><%= blog.title %></h1>
                    <p class="article-meta">Written by <strong><%= blog.createdBy.fullName %></strong></p>
                </header>
        <% if (blog.coverImageURL) { %>
                        <img src="<%= blog.coverImageURL %>" class="article-image" alt="Cover image for <%= blog.title %>">
        <% } %>
                <div class="article-body"><%= blog.body %></div>

                <div class="article-footer">
                    <p class="article-meta">Published on <%= blog.createdAt.toDateString() %></p>
                </div>
                <div class="article-comments">
                    <h2>Comments (<%= comments.length %>)</h2>
                    <% if (comments.length > 0) { %>
                        <ul class="comment-list">
                            <% comments.forEach((comment) => { %>
                                <li class="comment">
                                    <p class="comment-meta"><strong><%= comment.createdBy.fullName %></strong> on <%= comment.createdAt.toDateString() %></p>
                                    <p class="comment-body"><%= comment.content %></p>
                                </li>
                            <% }); %>
                        </ul>
                    <% } else { %>
                        <p>No comments yet. Be the first to comment!</p>
                    <% } %>
                    <% if (user) { %>
                        <form class="comment-form" action="/blog/comment/<%= blog._id %>" method="POST">
                            <div class="mb-3">
                                <label for="commentBody" class="form-label">Add a comment</label>
                                <textarea class="form-control" id="commentBody" name="content" rows="3" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-accent">Post comment</button>
                        </form>
                    <% } %>
                </div>
                <a class="back-link" href="/">&larr; Back to all stories</a>
            </article>
        </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>